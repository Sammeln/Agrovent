' --- ассоциации ---
AGR_SpecificationViewModel --> AGR_AssemblyComponentVM
AGR_SpecificationViewModel o-- "0..*" AGR_SpecificationItemVM
AGR_SpecificationViewModel --> IUnitOfWork
AGR_SpecificationViewModel ..> AGR_MatchArticlesVM : MatchArticlesCommand
AGR_SpecificationViewModel ..> AGR_SpecificationExcelExporter
AGR_AssemblyEditVM --> AGR_WindowMode_e
AGR_AssemblyEditVM *-- "0..*" AGR_AssemblyEditItemVM
AGR_AssemblyEditVM --> IUnitOfWork
AGR_AssemblyEditItemVM --> ComponentVersion
AGR_MatchArticlesVM *-- "0..*" AGR_ArticleMatchItemVM
AGR_ArticleMatchItemVM *-- "0..*" AGR_ArticleCandidateVM
AGR_ArticleMatchItemVM --> AGR_SpecificationItemVM
AGR_SaveConfirmationVM --> IAGR_BaseComponent
AGR_SaveConfirmationVM ..> AGR_SaveConfirmationErrors

AGR_EditSelectionViewModel --> AGR_EditSelectionMode_e
AGR_EditSelectionViewModel *-- "0..*" AGR_EditNodeVM : Roots
AGR_EditNodeVM "0..1" *-- "0..*" AGR_EditNodeVM : Children
AGR_EditSelectionViewModel ..> IAGR_EditLockService : CreateAsync

AGR_ComponentEditVM *-- "0..*" AGR_ComponentFileEditVM
AGR_ComponentEditVM *-- "0..*" AGR_ComponentPropertyEditVM
AGR_ComponentEditVM --> IUnitOfWork
AGR_ComponentFileEditVM --> ComponentFile
AGR_ComponentPropertyEditVM --> ComponentProperty
AGR_ComponentDetailsVM --> AGR_ComponentRegistryItemVM
AGR_SelectAvaArticleVM --> DataContext
AGR_ComponentRegistryVM o-- "0..*" AGR_ComponentRegistryItemVM

AGR_ProjectExplorerVM --> IServiceScopeFactory
AGR_ProjectExplorerVM *-- "0..*" AGR_ProjectNode : RootNodes
AGR_ProjectNode "0..1" *-- "0..*" AGR_ProjectNode : Children
AGR_ProjectNode "0..1" *-- "0..*" AGR_ComponentNode : Children
AGR_ComponentNode --> ComponentVersion
AGR_ProjectPickerVM o-- "0..*" AGR_ProjectNode

AGR_PackNGoVM *-- "1..*" AGR_PackNGoComponentVM
AGR_PackNGoVM *-- AGR_PackNGoNodeVM : RootNode
AGR_PackNGoNodeVM "0..1" *-- "0..*" AGR_PackNGoNodeVM : Children
AGR_PackNGoNodeVM --> AGR_PackNGoComponentVM
AGR_PackNGoComponentVM --> IAGR_BaseComponent
AGR_PackNGoVM ..> AGR_PackNGoFindReplaceVM

' --- View -> ViewModel (DataContext) ---
AGR_SpecificationWindow ..> AGR_SpecificationViewModel
