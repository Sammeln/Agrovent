SaveProgressView ..> AGR_SaveProgressVM
AGR_EditSelectionWindow ..> AGR_EditSelectionViewModel
AGR_MatchArticlesWindow ..> AGR_MatchArticlesVM
AGR_SelectAvaArticleView ..> AGR_SelectAvaArticleVM
AGR_ComponentRegistryView ..> AGR_ComponentRegistryVM
AGR_ProjectExplorerView ..> AGR_ProjectExplorerVM
AGR_ProjectPickerView ..> AGR_ProjectPickerVM
AGR_PackNGoWindow ..> AGR_PackNGoVM
AGR_PackNGoFindReplaceWindow ..> AGR_PackNGoFindReplaceVM
AGR_ComponentDetailsView ..> AGR_ComponentDetailsVM
AGR_ComponentRegistryTaskPaneView ..> AGR_ComponentRegistryTaskPaneVM
AGR_PartPageView ..> AGR_PartComponentVM
AGR_AssemblyPageView ..> AGR_AssemblyComponentVM
AGR_TaskPaneView ..> AGR_TaskPaneViewModel
