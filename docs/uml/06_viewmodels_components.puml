@startuml 06_viewmodels_components
title Agrovent.ViewModels — компоненты SolidWorks, свойства, материалы, панель задач

skinparam classAttributeIconSize 0
hide empty members

interface INotifyPropertyChanged
interface IAGR_BaseComponent
interface IAGR_Part
interface IAGR_Assembly
interface IAGR_HasFile
interface IAGR_HasMaterial
interface IAGR_HasPaint
interface IAGR_Material
interface IAGR_PageView
interface IAGR_SpecificationItem
interface IAGR_ComponentRegistryItemVM
interface IAGR_BasePropertiesCollection
interface IAGR_PartPropertiesCollection
interface IAGR_SheetMetallPropertiesCollection
class ComponentVersion <<entity>>
class AvaArticleModel <<entity>>

package "ViewModels.Base" {
  class BaseViewModel {
    + PropertyChanged : PropertyChangedEventHandler
    + IsLoading : bool
    + LoadingStatus : string
    # OnPropertyChanged(name)
    # Set<T>(ref field, value) : bool
  }
  INotifyPropertyChanged <|.. BaseViewModel

  class AGR_BaseComponent {
    - _scopeFactory : IServiceScopeFactory
    - _taskPane : AGR_TaskPaneViewModel
    + IsAlive : bool
    + SwDocument : ISwDocument3D
    + Name / ConfigName / Extension : string
    + PartNumber / Article : string
    + Version : int
    + StorageGuid : Guid?
    + FilePath : string
    + Preview : byte[]?
    + AvaArticle : IAGR_AvaArticleModel
    + ComponentVersion : ComponentVersion
    + IsInDatabase : AGR_ComponentDatabaseState_e
    + EditState : AGR_EditState_e
    + EditLockedBy : string?
    + HasMyLocks : bool
    + PropertiesCollection : IAGR_PropertiesCollection
    + ComponentType : AGR_ComponentType_e
    + AvaType : AGR_AvaType_e
    + ParentAssemblies : ICollection<IAGR_ComponentRegistryItemVM>?
    + CanUserEdit : bool
    + IsPurchased : bool
    + AGR_BaseComponent(swDocument3D)
    + RefreshFromDocument()
    + PrecomputePreview()
    .. COMMANDS ..
    + SelectAvaArticleCommand
    + OpenComponentCommand
    + AddToAssemblyCommand
    + ShowDetailsCommand
    + SetNewPartnumberCommand
    .. events ..
    + PartnumberChanged
  }

  class AGR_FileComponent {
    + CurrentModelFilePath / CurrentDrawFilePath : string
    + StorageModelFilePath / StorageDrawFilePath : string
    + ProductionModelFilePath / ProductionDrawFilePath : string
    + StorageModelFileIsExist ... ProductionDrawFileIsExist : bool
    + GetDrawFilePath() : string?
  }
}

package "ViewModels.Components" {
  class AGR_PartComponentVM {
    + BaseMaterial : IAGR_Material
    + BaseMaterialCount : decimal
    + Paint : IAGR_Material?
    + PaintCount : decimal?
    + UpdatePropertiesAsync() : Task
    + Refresh()
    .. COMMANDS ..
    + OpenFolderCommand
    + SelectBaseMaterialCommand
    + SelectPaintCommand
    + ClearPaintCommand
  }
  class AGR_AssemblyComponentVM {
    + SelectedItem : IAGR_BaseComponent
    + AGR_TopComponents : ObservableCollection<AGR_SpecificationItemVM>
    + SimpleTopComponents : ObservableCollection<AGR_SimpleSpecificationComponent>
    + Paint : IAGR_Material?
    + PaintCount : decimal?
    + GetChildComponents() : IEnumerable<IAGR_SpecificationItem>
    + GetFlatComponents(onlyActive) : IEnumerable<IAGR_SpecificationItem>
    + GetSimpleTopComponentsList()
    + Refresh()
    .. COMMANDS ..
    + OpenFolderCommand
    + SelectPaintCommand
    + ClearPaintCommand
  }
  class AGR_Material {
    + Name / Article / UOM : string
    + AvaModel : AvaArticleModel?
  }
  class AGR_Paint {
    + Name / Article / UOM : string
    + AvaModel : AvaArticleModel?
    + TryLoadAvaModelFromNameAsync() : Task<bool>
  }
  class AGR_Paint2 <<internal, legacy>>
  class AGR_ComponentRegistryItemVM {
    - _entity : ComponentVersion
    + Id / Version : int
    + Name / PartNumber / RawPartNumber : string
    + Preview : BitmapImage?
    + SavedByUserInitials : string
    + CreatedAt : DateTime
    + ComponentType : AGR_ComponentType_e
    + ComponentTypeDisplay / AvaTypeDisplay : string
    + StoragePath : string
  }
  class AGR_HomePageVM <<internal>>
}

package "ViewModels.Properties" {
  class AGR_BasePropertiesCollection <<internal>> {
    + Volume / Mass / SurfaceArea : IXProperty
    + Properties : ICollection<IXProperty>
    + UpdateProperties()
  }
  class AGR_PartPropertiesCollection <<internal>> {
    + Length / Width : IXProperty
  }
  class AGR_SheetPartPropertiesCollection <<internal>> {
    + SheetMetall_* : IXProperty (9 шт.)
  }
  class AGR_Property {
    + Name / Value / Expression : string
  }
}

package "ViewModels.Specification (элемент)" {
  class AGR_SpecificationItemVM {
    - _component : IAGR_BaseComponent
    + Component : IAGR_BaseComponent
    + Quantity : int
    + IsSelected : bool
    + BaseMaterial / BasePaint : IAGR_Material?
    + MaterialCount : decimal?
    + AvaArticle : IAGR_AvaArticleModel?
    + ComponentAvaType : AGR_AvaType_e
    + PartnumberOrArticle / MaterialInfo : string
  }
  class AGR_SimpleSpecificationComponent {
    + Name / ConfigName / PartNumber : string
    + Quantity : int
  }
}

package "ViewModels.TaskPane" {
  class AGR_TaskPaneViewModel <<singleton>> {
    - _app : ISwApplication
    - _viewModelFactory : IAGR_ComponentViewModelFactory
    - _unitOfWork : IUnitOfWork
    - _viewModelCache : IAGR_ViewModelCacheService
    - _editLocks : IAGR_EditLockService
    + ActiveUser : IAGR_User
    + ActiveComponent : ISwDocument3D
    + ActiveView : IAGR_PageView
    + BaseComponent / Selection : IAGR_PageView
    + LoadingMessage : string
    + LoadingProgress / TotalComponents : int
    + OnDocumentActivatedAsync(doc : IXDocument)
    + LoadComponentDataFromDatabaseAsync(component) : Task
    + Dispose()
  }
  class AGR_ComponentRegistryTaskPaneVM <<singleton>> {
    - _componentRepository : IAGR_ComponentRepository
    - _scopeFactory : IServiceScopeFactory
    - _app : ISwApplication
    + RegistryItems : ObservableCollection<AGR_ComponentRegistryItemVM>
    + SelectedItem : AGR_ComponentRegistryItemVM
    + RegistryItemsView : ICollectionView
    + SearchText / SelectedComponentType / SelectedAvaType : string?
    .. COMMANDS ..
    + LoadDataCommand
    + OpenComponentCommand
    + AddToAssemblyCommand
    + ShowDetailsCommand
  }
  note bottom of AGR_TaskPaneViewModel
    Устаревший дубль: Agrovent.ViewModels.Tree.AGR_TaskPaneViewModel
    (DI и add-in используют вариант из ViewModels.TaskPane)
  end note
}

