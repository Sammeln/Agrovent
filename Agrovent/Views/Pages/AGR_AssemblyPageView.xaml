<UserControl x:Class="Agrovent.Views.Pages.AGR_AssemblyPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Agrovent.ViewModels.Components"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:local="clr-namespace:Agrovent.Views.Pages"
             xmlns:enum="clr-namespace:AgroventInfrastructure.Enums;assembly=AgroventInfrastructure"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:components="clr-namespace:Agrovent.ViewModels.Components"
             xmlns:AGR_converter="clr-namespace:AgroventInfrastructure.AGR_Converters;assembly=AgroventInfrastructure"
             d:DataContext="{d:DesignInstance Type={x:Type vm:AGR_AssemblyComponentVM}}"
            mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800">
    <!--xmlns:converter="clr-namespace:Agrovent.Infrastructure.Converters"-->

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Style/PartComponentStyle.xaml"/>
                <ResourceDictionary Source="../Style/SpecificationStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ObjectDataProvider x:Key="AvaTypeEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="enum:AGR_AvaType_e"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <AGR_converter:AGR_ComponentTypeToVisibility x:Key="ComponentTypeToVisibilityConverter"/>
            <AGR_converter:AGR_ComponentDBStateConverter x:Key="ComponentDBStateConverter"/>
            <AGR_converter:AGR_AvaTypeConverter x:Key="AvaTypeConverter"/>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <!-- Converter для видимости секций -->
            <AGR_converter:AGR_NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="Данные">
            <ScrollViewer Height="790">
                <StackPanel Margin="16" Orientation="Vertical">
                    <!-- Секция: Основная информация -->
                    <Expander Style="{StaticResource CardStyleExpander}" IsExpanded="True">
                        <Expander.Header>
                            <TextBlock Text="Основная информация" Style="{StaticResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel Orientation="Vertical">
                            <!-- Секция: Статус в базе данных -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsInDatabase, Converter={StaticResource ComponentDBStateConverter}, ConverterParameter=SavedInDataBase }"
                                        Margin="0 0 0 5">
                                <TextBlock Text="✓ Компонент сохранён в базе данных" 
                                Style="{StaticResource SectionHeaderStyle}"
                                Foreground="Green" />
                                <Button Margin="5 0" Padding="2.5" Content="Информация" Command="{Binding ShowDetailsCommand}" VerticalAlignment="Top"/>
                            </StackPanel>
                            <!-- Секция: Статус в базе данных -->
                            <TextBlock Text="! Компонент не сохранён в базе данных" 
                           Style="{StaticResource SectionHeaderStyle}"
                           Foreground="Orange"
                           Visibility="{Binding IsInDatabase, Converter={StaticResource ComponentDBStateConverter}, ConverterParameter=NotSavedInDB}"/>

                            <!-- Секция: Статус в базе данных -->
                            <TextBlock Text="! Компонент используется в нескольких изделиях!" 
                           Style="{StaticResource SectionHeaderStyle}"
                           Foreground="IndianRed"
                           Visibility="{Binding CanUserEdit, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            <!-- Наименование -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}">
                                <TextBlock Text="Наименование:" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBox Text="{Binding Name, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}"/>
                            </DockPanel>

                            <!-- Тип AVA -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}">
                                <TextBlock Text="Тип:" Style="{StaticResource PropertyLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AvaTypeEnum}}"
                                  SelectedItem="{Binding AvaType}"
                                  Style="{StaticResource ModernComboBox}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource AvaTypeConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DockPanel>

                            <!-- Артикул -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}">
                                <TextBlock Text="Артикул:" Style="{StaticResource PropertyLabelStyle}"/>
                                <Border BorderBrush="Gray" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding AvaArticle.Article, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource ReadOnlyTextBox}" BorderThickness="0" Grid.Column="0">
                                            <i:Interaction.Triggers>
                                            <i:EventTrigger EventName="MouseDoubleClick">
                                                <i:InvokeCommandAction Command="{Binding SelectAvaArticleCommand}"/>
                                            </i:EventTrigger>
                                        </i:Interaction.Triggers>
                                        </TextBox>
                                        <Button Grid.Column="1" Content=". . ." Command="{Binding SelectAvaArticleCommand}"/>
                                    </Grid>
                                </Border>
                            </DockPanel>

                            <!-- Partnumber -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}"
                               Visibility="{Binding ComponentType,Converter={StaticResource ComponentTypeToVisibilityConverter}, ConverterParameter=False}">
                                <TextBlock Text="Partnumber:" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBox Text="{Binding PartNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}">
                                    <TextBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Создать новый" Command="{Binding SetNewPartnumberCommand}"/>
                                        </ContextMenu>
                                    </TextBox.ContextMenu>
                                </TextBox>
                            </DockPanel>

                            <!-- Версия -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}" Visibility="{Binding ComponentType,Converter={StaticResource ComponentTypeToVisibilityConverter}, ConverterParameter=False}">
                                <TextBlock Text="Версия:" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBox Text="{Binding Version, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ReadOnlyTextBox}"/>
                            </DockPanel>

                            <!-- Хэш -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}" Visibility="Collapsed">
                                <TextBlock Text="Хэш:" Style="{StaticResource PropertyLabelStyle}"/>
                                <TextBox Text="{Binding ComponentHash, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}"
                                 Style="{StaticResource ReadOnlyTextBox}"/>
                            </DockPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Секция: Компоненты сборки -->
                    <Expander Style="{StaticResource CardStyleExpander}" IsExpanded="True"
                          Visibility="{Binding ComponentType,NotifyOnSourceUpdated=True, 
                            NotifyOnTargetUpdated=True, Converter={StaticResource ComponentTypeToVisibilityConverter}, ConverterParameter=False}">
                        <Expander.Header>
                            <TextBlock Text="Компоненты сборки" Style="{StaticResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>

                            <!--Вкладки для разных типов компонентов-->
                            <DataGrid ItemsSource="{Binding SimpleTopComponents}" 
                                      Style="{StaticResource ComponentsDataGrid}" 
                                  IsReadOnly="False" VerticalScrollBarVisibility="Hidden"
                                  MaxHeight="300">
                                <DataGrid.Columns>

                                    <DataGridTemplateColumn Header="Название" Width="4*" SortMemberPath="Name">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBox Style="{StaticResource DG_ReadOnlyTextBox}" Text="{Binding Name, Mode=OneWay}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="PartNumber" Width="1.2*" SortMemberPath="PartNumber">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource DG_ReadOnlyTextBox}" Text="{Binding PartNumber, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Кол-во" Width="0.7*" SortMemberPath="Quantity">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Style="{StaticResource DG_ReadOnlyTextBox}" Text="{Binding Quantity, Mode=OneWay}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>

                    <!-- Секция: Покраска -->
                    <Expander  Style="{StaticResource CardStyleExpander}" IsExpanded="True" 
                        Visibility="{Binding ComponentType,
                        NotifyOnSourceUpdated=True,
                       NotifyOnTargetUpdated=True, Converter={StaticResource ComponentTypeToVisibilityConverter}, ConverterParameter=False}">
                        <Expander.Header>
                            <TextBlock Text="Покраска" Style="{StaticResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <!-- Название краски -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}">
                                <TextBlock Text="Краска:" Style="{StaticResource PropertyLabelStyle}"/>
                                <Border BorderBrush="Gray" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Paint.Name, Mode=OneWay}" Style="{StaticResource ReadOnlyTextBox}" Grid.Column="0" BorderThickness="0"> 
                                            <i:Interaction.Triggers>
                                                <i:EventTrigger EventName="MouseDoubleClick">
                                                    <i:InvokeCommandAction Command="{Binding SelectPaintCommand}"/>
                                                </i:EventTrigger>
                                            </i:Interaction.Triggers>
                                            <TextBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Найти краску" Command="{Binding SelectPaintCommand}"/>
                                                    <MenuItem Header="Очистить" Command="{Binding ClearPaintCommand}"/>
                                                </ContextMenu>
                                            </TextBox.ContextMenu>
                                        </TextBox>
                                        <Button Grid.Column="1" Content=". . ." Command="{Binding SelectPaintCommand}"/>
                                    </Grid>
                                </Border>
                            </DockPanel>


                        </StackPanel>
                    </Expander>

                    <!-- Секция: Пользовательские свойства -->
                    <Expander Style="{StaticResource CardStyleExpander}" IsExpanded="False" Visibility="{Binding ComponentType,NotifyOnSourceUpdated=True, 
                                NotifyOnTargetUpdated=True, Converter={StaticResource ComponentTypeToVisibilityConverter}, ConverterParameter=False}">
                        <Expander.Header>
                            <TextBlock Text="Свойства" Style="{StaticResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>
                            <DataGrid ItemsSource="{Binding PropertiesCollection.Properties}"  
                              Style="{StaticResource PropertiesDataGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Свойство" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="Значение" Binding="{Binding Value}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Expander>

                    <!-- Секция: Файлы -->
                    <Expander Style="{StaticResource CardStyleExpander}" IsExpanded="False" Visibility="{Binding ComponentType,NotifyOnSourceUpdated=True, 
                                NotifyOnTargetUpdated=True, Converter={StaticResource ComponentTypeToVisibilityConverter}, ConverterParameter=False}">
                        <Expander.Header>
                            <TextBlock Text="Файлы" Style="{StaticResource SectionHeaderStyle}"/>
                        </Expander.Header>
                        <StackPanel>

                            <!-- Открытый файл -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}">
                                <TextBlock Text="Открытый файл:" Style="{StaticResource PropertyLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding CurrentModelFilePath, Mode=OneWay}" 
                                 Style="{StaticResource ReadOnlyTextBox}"
                                 TextWrapping="NoWrap">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding OpenFolderCommand}"
                                       CommandParameter="{Binding CurrentModelFilePath}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                            </DockPanel>


                            <!-- Файл в хранилище -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}" 
                                Visibility="{Binding StorageModelFileIsExist, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Файл в хранилище:" Style="{StaticResource PropertyLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding StorageModelFilePath, Mode=OneWay}" 
                            Style="{StaticResource ReadOnlyTextBox}"
                            TextWrapping="NoWrap">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding OpenFolderCommand}"
                                       CommandParameter="{Binding StorageModelFilePath}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                            </DockPanel>


                            <!-- Файл в папке производства -->
                            <DockPanel Style="{StaticResource PropertyGroupStyle}" 
                                Visibility="{Binding ProductionModelFileIsExist, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Файл в папке производства:" Style="{StaticResource PropertyLabelStyle}" TextWrapping="Wrap"/>
                                <TextBox Text="{Binding ProductionModelFilePath, Mode=OneWay}" 
                            Style="{StaticResource ReadOnlyTextBox}"
                            TextWrapping="NoWrap">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="MouseDoubleClick">
                                            <i:InvokeCommandAction Command="{Binding OpenFolderCommand}"
                                       CommandParameter="{Binding ProductionModelFilePath}"/>
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </TextBox>
                            </DockPanel>



                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>

        </TabItem>
        <TabItem Header="Где используется">
            <TabItem.Resources>
                <DataTemplate x:Key="PreviewImageTemplate">
                    <Image Source="{Binding Preview}" MaxHeight="50" MaxWidth="50" Stretch="Uniform" />
                </DataTemplate>

                <!-- ContextMenu -->
                <ContextMenu  x:Key="RowMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem 
                    Header="Открыть" CommandParameter="{Binding}"
                    Command="{Binding DataContext.OpenComponentCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" />
                    <MenuItem 
                    Header="Вставить в сборку" CommandParameter="{Binding}"
                    Command="{Binding DataContext.AddToAssemblyCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" Visibility="Collapsed"/>
                    <MenuItem 
                    Header="Подробная информация" CommandParameter="{Binding}"
                    Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" Visibility="Collapsed" />
                </ContextMenu>

                <Style x:Key="DefaultRowStyle" TargetType="{x:Type DataGridRow}">
                    <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                </Style>
            </TabItem.Resources>
            <Grid>
                <!-- DataGrid -->
                <DataGrid
                          ItemsSource="{Binding ParentAssemblies}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          IsReadOnly="True"
                          RowStyle="{StaticResource DefaultRowStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" CanUserResize="False" Width="SizeToCells"/>
                        <!-- Превью -->
                        <DataGridTemplateColumn Width="40" CanUserResize="False">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <Image Source="{Binding Preview}" Width="800"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="50" />
                                    <Setter Property="ToolTipService.Placement" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type components:AGR_ComponentRegistryItemVM}">
                                    <!-- Контейнер для основного отображения в ячейке -->
                                    <Image Source="{Binding Preview}" MaxHeight="50" MaxWidth="50" Stretch="Uniform"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Наименование -->
                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="SizeToCells" />
                        <!-- PartNumber -->
                        <DataGridTextColumn Header="Обозначение" Binding="{Binding PartNumber}" Width="SizeToHeader" />
                        <!-- Version -->
                        <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="SizeToHeader" />
                        <!-- Кто сохранил -->
                        <DataGridTextColumn Header="Сохранил" Binding="{Binding SavedByUserInitials}" Width="SizeToCells" />
                        <!-- Дата создания -->
                        <DataGridTextColumn Header="Дата сохранения" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>