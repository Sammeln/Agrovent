<Window x:Class="Agrovent.Views.Windows.AGR_PackNGoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Agrovent.ViewModels.PackNGo"
        xmlns:AGR_converter="clr-namespace:AgroventInfrastructure.AGR_Converters;assembly=AgroventInfrastructure"
        Title="Pack'n'Go"
        Width="820" Height="640"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <ResourceDictionary>
            
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../Style/PartComponentStyle.xaml"/>
            <ResourceDictionary Source="../Style/SpecificationStyle.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <!-- BoolToVisibilityConverter уже объявлен глобально в App.xaml (используется по всему
             Agrovent, см. AGR_InverseBooleanConverter/оверлеи загрузки). Здесь объявляем только
             два новых конвертера, специфичных для дерева Pack'n'Go. -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <AGR_converter:AGR_IndentToMarginConverter x:Key="LeftMarginConverter"/>
        <AGR_converter:AGR_ExpandGlyphConverter x:Key="ExpandGlyphConverter"/>

        <!-- Подсветка ячейки PartNumber светло-зелёным, если партномер пуст ("новый") -->
        <Style x:Key="PartNumberCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ComponentVM.IsNewPartNumber}" Value="True">
                    <Setter Property="Background" Value="#C8F7C5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Покупные компоненты нельзя переименовывать - блокируем редактирование ячейки
             "Сохранить как" целиком (IsEnabled=False не даёт войти в режим редактирования)
             и слегка затемняем её, чтобы было видно, что поле недоступно. -->
        <Style x:Key="SaveAsNameCellStyle" TargetType="DataGridCell">
            <Style.Triggers>
                <DataTrigger Binding="{Binding ComponentVM.IsPurchased}" Value="True">
                    <Setter Property="IsEnabled" Value="False"/>
                    <Setter Property="Background" Value="#F0F0F0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Табличное представление дерева сборки -->
        <!-- Табличное представление дерева сборки -->
        <DataGrid Grid.Row="0"
                  ItemsSource="{Binding VisibleNodes}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserSortColumns="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0"
                  
                  SelectionUnit="Cell">
            <DataGrid.Columns>

                <!-- Чекбокс "копировать" -->
                <!--<DataGridTemplateColumn Header="" Width="34">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:AGR_PackNGoNodeVM}">
                            <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsChecked="{Binding ComponentVM.IsChecked, Mode=TwoWay}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>-->

                <!-- "Компонент" - имя, с отступом по уровню вложенности и кнопкой раскрытия -->
                <DataGridTemplateColumn Header="Компонент" Width="*" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:AGR_PackNGoNodeVM}">
                            <StackPanel Orientation="Horizontal" Margin="{Binding Indent, Converter={StaticResource LeftMarginConverter}}">
                                <!--<ToggleButton Width="16" Height="16" Margin="0,0,4,0"
                                              Visibility="{Binding HasChildren, Converter={StaticResource BoolToVisibilityConverter}}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                              Content="{Binding IsExpanded, Converter={StaticResource ExpandGlyphConverter}}"/>-->
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- "Сохранить как" - редактируемое имя файла без расширения. Для покупных
                     компонентов ячейка неактивна (см. SaveAsNameCellStyle) - их нельзя переименовывать. -->
                <DataGridTextColumn Header="Сохранить как" Width="*"
                                     CellStyle="{StaticResource SaveAsNameCellStyle}"
                                     Binding="{Binding ComponentVM.SaveAsName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                <!-- PartNumber - только отображение + контекстное меню "Новый". Для покупных
                     компонентов значение не показывается вообще (DisplayPartNumber - пустая строка
                     для них), а пункт "Новый" неактивен (см. SetNewCommand.CanExecute). -->
                <DataGridTemplateColumn Header="PartNumber" Width="2*" CellStyle="{StaticResource PartNumberCellStyle}" IsReadOnly="True">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type vm:AGR_PackNGoNodeVM}">
                            <TextBlock Text="{Binding ComponentVM.DisplayPartNumber}" VerticalAlignment="Center" Margin="4,0">
                                <TextBlock.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Новый"
                                                  Command="{Binding ComponentVM.SetNewCommand}"/>
                                    </ContextMenu>
                                </TextBlock.ContextMenu>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <!-- Найти/Заменить -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Найти/Заменить" Width="140" HorizontalAlignment="Left"
                    Command="{Binding FindReplaceCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <!-- Сохранить куда -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Сохранить куда:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding SaveFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="2" Content="Обзор..." Width="90" Margin="8,0,0,0"
                    Command="{Binding BrowseFolderCommand}"/>
        </Grid>

        <!-- Сохранить / Отмена -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Сохранить" Width="110" Margin="0,0,8,0"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="Отмена" Width="110"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>

        <!-- Оверлей загрузки на время сохранения (см. IsLoading/LoadingStatus в BaseViewModel,
             тот же приём, что и в остальных окнах Agrovent, напр. AGR_AssemblyEditVM). -->
        <Grid Grid.Row="0" Grid.RowSpan="4"
              Background="#AAFFFFFF"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="220" Height="16"/>
                <TextBlock Text="{Binding LoadingStatus}" Margin="0,8,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
