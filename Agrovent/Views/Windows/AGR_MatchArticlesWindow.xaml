<Window x:Class="Agrovent.Views.Windows.AGR_MatchArticlesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Agrovent.Views.Windows"
        xmlns:vm="clr-namespace:Agrovent.ViewModels.Specification"
        xmlns:AGR_converter="clr-namespace:AgroventInfrastructure.AGR_Converters;assembly=AgroventInfrastructure"
        d:DataContext="{d:DesignInstance Type={x:Type vm:AGR_MatchArticlesVM}}"
        mc:Ignorable="d"
        Title="Подбор артикулов"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Topmost="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Style/PartComponentStyle.xaml"/>
                <ResourceDictionary Source="../Style/SpecificationStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок / пояснение -->
        <Border Grid.Row="0" Background="White" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Для каждого компонента выберите подходящий артикул из найденных вариантов (отмечен один - радиокнопкой). Компоненты, для которых варианты не найдены или уже назначен артикул, в списке не отображаются."
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <TextBlock Margin="24,0,0,0" VerticalAlignment="Center" FontWeight="Bold"
                           Foreground="DarkOrange"
                           Visibility="{Binding HasUnresolved, Converter={StaticResource BoolToVisibilityConverter}}"
                           Text="{Binding UnresolvedCount, StringFormat='Не выбрано вариантов: {0}'}"/>
            </StackPanel>
        </Border>

        <!-- Основная таблица -->
        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding GroupedItemsView}"
                  Style="{StaticResource SpecificationDataGrid}"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="LightGray"
                  AutoGenerateColumns="False"
                  CanUserSortColumns="True"
                  CanUserAddRows="False"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto">

            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.ContainerStyle>
                        <Style TargetType="{x:Type GroupItem}" BasedOn="{StaticResource GroupHeaderStyle}"/>
                    </GroupStyle.ContainerStyle>
                </GroupStyle>
            </DataGrid.GroupStyle>

            <DataGrid.Columns>

                <!-- Компонент из спецификации -->
                <DataGridTemplateColumn Header="Компонент" Width="280">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding PartNumber}" Foreground="Gray" TextWrapping="Wrap"/>
                                <TextBlock Foreground="Gray">
                                    <Run Text="Кол-во: "/>
                                    <Run Text="{Binding Quantity, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Найденные варианты AvaArticle -->
                <DataGridTemplateColumn Header="Найденные варианты (выберите один)" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" Margin="4">

                                <!-- Список кандидатов -->
                                <ItemsControl ItemsSource="{Binding Candidates}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <RadioButton IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         Margin="0,2"
                                                         VerticalContentAlignment="Center">
                                                <RadioButton.ToolTip>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"/>
                                                        <TextBlock Text="{Binding DisplayPartNumber}"/>
                                                    </StackPanel>
                                                </RadioButton.ToolTip>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayArticle}" FontWeight="SemiBold" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding DisplayPartNumber}"
                                                               Foreground="Gray" Margin="6,0,0,0"/>
                                                    <TextBlock Text=" (совпадение по Partnumber)"
                                                               Foreground="ForestGreen" FontStyle="Italic"
                                                               Visibility="{Binding IsPartNumberMatch, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Нет вариантов -->
                                <TextBlock Text="Подходящие варианты не найдены"
                                           Foreground="Gray" FontStyle="Italic"
                                           Visibility="{Binding NoCandidatesFound, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- Сброс выбора -->
                                <Button Content="Без артикула" HorizontalAlignment="Left"
                                        Margin="0,4,0,0" Padding="6,2"
                                        Visibility="{Binding HasCandidates, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsResolved}" Value="False">
                            <Setter Property="Background" Value="#FFF6E5"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>

        </DataGrid>

        <!-- Панель действий -->
        <Border Grid.Row="2" Background="White" Padding="16,12" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource AcceptButtonStyle}"
                        Command="{Binding SaveCommand}"/>
                <Button Content="Отмена"
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource CancelButtonStyle}"/>
            </StackPanel>
        </Border>

        <!-- Оверлей загрузки -->
        <Border Grid.RowSpan="3" Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                <TextBlock Text="{Binding LoadingStatus}"
                           Foreground="White"
                           FontSize="16"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
