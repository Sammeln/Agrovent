<Window x:Class="Agrovent.Views.Windows.AGR_SpecificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Agrovent.Views.Windows"
        xmlns:vm="clr-namespace:Agrovent.ViewModels.Specification"
        xmlns:converter="clr-namespace:Agrovent.Infrastructure.Converters"
        xmlns:AGR_converter="clr-namespace:AgroventInfrastructure.AGR_Converters;assembly=AgroventInfrastructure"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:b="clr-namespace:AgroventInfrastructure.Behaviors;assembly=AgroventInfrastructure"
        xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
        xmlns:enum="clr-namespace:AgroventInfrastructure.Enums;assembly=AgroventInfrastructure"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        d:DataContext="{d:DesignInstance Type={x:Type vm:AGR_SpecificationViewModel}}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" 
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Loaded="Window_Loaded">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Style/PartComponentStyle.xaml"/>
                <ResourceDictionary Source="../Style/SpecificationStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Перечисление AvaType для ComboBox -->
            <ObjectDataProvider x:Key="AvaTypeEnum" MethodName="GetValues"
                                ObjectType="{x:Type system:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="enum:AGR_AvaType_e"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>

            <!-- Конвертеры -->
            <converter:GroupHeaderColorConverter x:Key="GroupHeaderColorConverter"/>
            <!--<converter:AGR_ComponentTypeConverter x:Key="ComponentTypeConverter"/>-->
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <AGR_converter:AGR_AvaTypeConverter x:Key="AvaTypeConverter"/>
            <AGR_converter:AGR_InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <AGR_converter:AGR_InverseBooleanConverter x:Key="InverseBoolToVisibilityConverter"/>
            <AGR_converter:AGR_ComponentTypeToVisibility x:Key="ComponentTypeToVisibility"/>
            <AGR_converter:AGR_NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>


            <DataTemplate DataType="{x:Type ImageSource}">
                <Image Source="{Binding BaseAssemblyPreview}" MaxHeight="200" MaxWidth="200" Stretch="Uniform" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:AGR_SpecificationItemVM}">
                <Image Source="{Binding Preview}"  MaxHeight="200" MaxWidth="200" Stretch="Uniform" />
            </DataTemplate>

            <!-- ContextMenu -->
            <ContextMenu  x:Key="RowMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                <MenuItem 
                     Header="Установить материал" CommandParameter="{Binding}"
                     Command="{Binding DataContext.SetBaseMaterialCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" />
                <MenuItem 
                     Header="Установить покрытие...">
                    <MenuItem 
                         Header="Найти артикул" CommandParameter="{Binding}"
                         Command="{Binding DataContext.SetPaintCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"/>
                    <MenuItem 
                         Header="Без покрытия" CommandParameter="NoPaint"
                         Command="{Binding DataContext.SetPaintCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"/>

                </MenuItem>
                <MenuItem 
                     Header="Установить артикул...">
                        <MenuItem 
                         Header="Найти артикул" CommandParameter="{Binding}"
                         Command="{Binding DataContext.SetAvaArticleCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" />
                    <MenuItem 
                         Header="Очистить артикул" CommandParameter="NoArticle"
                         Command="{Binding DataContext.SetAvaArticleCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}"/>
                </MenuItem>
                <MenuItem 
                     Header="Установить тип...">
                    <MenuItem Header="Покупное" CommandParameter="20021" 
                              Command="{Binding DataContext.SetAvaTypeCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" />
                    <MenuItem Header="Комплектующая" CommandParameter="5" 
                              Command="{Binding DataContext.SetAvaTypeCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" />
                    <MenuItem Header="Продукция" CommandParameter="3" 
                              Command="{Binding DataContext.SetAvaTypeCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" />
                    <MenuItem Header="Виртуальный компонент" CommandParameter="50625" 
                              Command="{Binding DataContext.SetAvaTypeCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}}" />
                </MenuItem>
            </ContextMenu>

            <!-- Конвертеры видимости для разных типов компонентов -->
            <!--<converter:ComponentTypeToVisibilityConverter x:Key="MaterialVisibilityConverter" 
                Parameter="Part,SheetMetallPart"/>
            <converter:ComponentTypeToVisibilityConverter x:Key="PaintVisibilityConverter" 
                Parameter="Assembly,Part,SheetMetallPart"/>
            <converter:ComponentTypeToVisibilityConverter x:Key="ThicknessVisibilityConverter" 
                Parameter="SheetMetallPart"/>-->

        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок окна -->
            <Border Grid.Row="0" Style="{StaticResource WindowHeaderStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding WindowTitle}" 
                           Foreground="White" 
                           FontSize="16" 
                           FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Панель с превью главной сборки и настройками -->
            <Border Grid.Row="1" Background="#F5F5F5" Padding="16" Margin="16,8,16,8" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Превью главной сборки -->
                    <Border Grid.Column="0" Width="150" Height="150" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,0,16,0">
                        <Image Source="{Binding BaseAssemblyPreview}" Stretch="Uniform" />
                    </Border>

                    <!-- Информация о главной сборке и настройки -->
                    <StackPanel Grid.Column="1" Orientation="Vertical">

                        <!-- Наименование -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Наименование:" FontWeight="Bold" Margin="0,0,8,8"/>
                            <TextBlock Grid.Column="1" Text="{Binding BaseAssemblyName}" Margin="0,0,0,8"/>
                            <TextBlock Text="Конфигурация:" FontWeight="Bold" Margin="8,0,8,8"/>
                            <TextBlock Grid.Column="1" Text="{Binding ConfigName}" Margin="0,0,0,8"/>
                        </StackPanel>

                        <!-- Partnumber -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Partnumber:" FontWeight="Bold" Margin="0,0,8,8"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BaseAssemblyPartNumber}" Margin="0,0,8,8"/>
                        </StackPanel>

                        <!-- Тип AVA -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Тип:" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center"/>

                            <ComboBox ItemsSource="{Binding Source={StaticResource AvaTypeEnum}}"
                                  SelectedItem="{Binding BaseAssemblyAvaTypeEnum}"
                                  Width="150"
                                  Style="{StaticResource ModernComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource AvaTypeConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Артикул -->
                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Артикул:" FontWeight="Bold" Margin="0,0,8,8"/>
                                <Button Content="Выбрать" Command="{Binding SelectArticleCommand}" Padding="8,4" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding ArticleString}" Margin="10,0,8,8"/>
                                <!-- Чекбокс "Без артикула" -->
                                <CheckBox Grid.Row="3" Grid.Column="0" Content="Без артикула" IsChecked="{Binding NoArticle}" Margin="0,0,0,8"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Vertical">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Покрытие:" FontWeight="Bold" Margin="0,0,8,8"/>
                                <Button Content="Выбрать" Command="{Binding SelectPaintCommand}" Padding="8,4" Margin="8,0,0,8" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding BaseAssemblyPaintName}" Margin="8,0,8,8"/>
                                <!-- Чекбокс "Без покрытия" -->
                                <CheckBox Content="Без покрытия" IsChecked="{Binding NoPaint}" Margin="0,0,0,8"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основной контент - DataGrid с группировкой и панель ошибок -->
            <Grid Grid.Row="2" Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition  Width="auto"/>
                </Grid.ColumnDefinitions>

                <Grid.Resources>
                    <!-- CollectionViewSource для группировки компонентов -->
                    <CollectionViewSource x:Key="1GroupedComponents" 
                                      Source="{Binding Components, NotifyOnSourceUpdated=True, UpdateSourceTrigger=PropertyChanged}">
                        <CollectionViewSource.GroupDescriptions>
                            <PropertyGroupDescription PropertyName="ComponentType"/>
                        </CollectionViewSource.GroupDescriptions>
                        <CollectionViewSource.SortDescriptions>
                            <scm:SortDescription PropertyName="ComponentType" Direction="Ascending"/>
                            <scm:SortDescription PropertyName="Name" Direction="Ascending"/>
                        </CollectionViewSource.SortDescriptions>
                    </CollectionViewSource>
                </Grid.Resources>

                <!-- DataGrid с группировкой -->
                <!--ItemsSource="{Binding  Source={StaticResource GroupedComponents}}"-->
                <DataGrid Grid.Column="0"
                      ItemsSource="{Binding GroupedComponentsView}"
                      Style="{StaticResource SpecificationDataGrid}"
                          Name="ComponentsDataGrid"
                      GridLinesVisibility="Vertical"
                      VerticalGridLinesBrush="LightGray"
                      AutoGenerateColumns="False"
                      CanUserSortColumns="True"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Auto"
                      b:AGR_DataGridSelectedItemsBehavior.SelectedItems="{Binding SelectedComponents, Mode=TwoWay}"
                      >

                    <DataGrid.InputBindings>
                        <KeyBinding Key="Space" Command="{Binding SelectComponentCommand}"/>
                        <MouseBinding Gesture="LeftDoubleClick" Command="{Binding SelectComponentCommand}"/>
                    </DataGrid.InputBindings>


                    <!-- Настройка группировки -->
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="{x:Type GroupItem}" BasedOn="{StaticResource GroupHeaderStyle}"/>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>

                    <!-- Колонки DataGrid -->
                    <DataGrid.Columns>

                        <DataGridTemplateColumn Width="25">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Preview Column -->
                        <DataGridTemplateColumn Width="50" MinWidth="50">
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="ToolTip">
                                        <Setter.Value>
                                            <Image Source="{Binding Preview}" Width="450"/>
                                        </Setter.Value>
                                    </Setter>
                                    <Setter Property="ToolTipService.InitialShowDelay" Value="50" />
                                    <Setter Property="ToolTipService.Placement" Value="Right"/>
                                </Style>
                            </DataGridTemplateColumn.CellStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:AGR_SpecificationItemVM}">
                                    <!-- Контейнер для основного отображения в ячейке -->
                                    <Image Source="{Binding Preview}" MaxHeight="50" MaxWidth="50" Stretch="Uniform"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Наименование -->
                        <DataGridTemplateColumn Header="Наименование" SortMemberPath="Name" Width="SizeToCells">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}" Visibility="{Binding Material, Converter={StaticResource NullToVisibilityConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ArticleName}" 
                                               Visibility="{Binding Paint, Converter={StaticResource NullToVisibilityConverter}}" 
                                               VerticalAlignment="Center" Foreground="BlueViolet"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>



                        <!-- PartNumber/Артикул -->
                        <DataGridTextColumn Header=" PartNumber / Артикул " 
                                        Width="SizeToCells"
                                        CanUserSort="True"
                                        ElementStyle="{StaticResource DGCell_LeftAlignedAndWrapping}"
                                        Binding="{Binding PartnumberOrArticle}">
                        </DataGridTextColumn>
                       
                        <!-- Количество -->
                        <DataGridTextColumn Header=" Количество " 
                                        Binding="{Binding Quantity}" 
                                        Width="*"
                                        CanUserSort="True"
                                        ElementStyle="{StaticResource CenterAlignedTextStyle}"/>

                        <!-- Толщина -->
                        <DataGridTextColumn Header=" Толщина " 
                                        Binding="{Binding SheetMetalThickness}" 
                                        Width="SizeToHeader"
                                        ElementStyle="{StaticResource CenterAlignedTextStyle}"/>

                        <!-- Материал -->
                        <DataGridTemplateColumn Header="Материал" SortMemberPath="Name" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MaterialArticle}" Visibility="{Binding Material, Converter={StaticResource NullToVisibilityConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding MaterialName}" 
                                               Visibility="{Binding Paint, Converter={StaticResource NullToVisibilityConverter}}" 
                                               VerticalAlignment="Center" Foreground="BlueViolet"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Краска -->
                        <DataGridTemplateColumn Header="Краска" SortMemberPath="Name" Width="3*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PaintArticle}" Visibility="{Binding Material, Converter={StaticResource NullToVisibilityConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding PaintName}" 
                                               Visibility="{Binding Paint, Converter={StaticResource NullToVisibilityConverter}}" 
                                               VerticalAlignment="Center" Foreground="BlueViolet"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter Property="Background" Value="LightBlue"/>
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="ContextMenu" Value="{StaticResource RowMenu}"/>
                        </Style>
                    </DataGrid.RowStyle>

                </DataGrid>

                <!-- Панель ошибок справа -->
                <Border Grid.Column="1"
                    Style="{StaticResource ErrorBorderStyle}"
                    Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Ошибки:" 
                               FontWeight="Bold" 
                                   TextDecorations="Underline"
                               Style="{StaticResource ErrorTextblockStyle}"/>
                            <TextBlock Text="{Binding Errors}" 
                               Style="{StaticResource ErrorTextblockStyle}"/>
                            <TextBlock Text="{Binding Warnings}" 
                                Style="{StaticResource WarningTextblockStyle}"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Сообщение при отсутствии компонентов -->
                <!--<TextBlock Text="Нет компонентов для отображения" 
                       Style="{StaticResource EmptySpecificationStyle}"
                       Visibility="{Binding HasComponents, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=true}"/>-->
            </Grid>

            <!-- Панель действий -->
            <Border Grid.Row="3" 
                Background="White" 
                Padding="16,12" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,1,0,0">
                <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="Подобрать артикулы..."
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Command="{Binding MatchArticlesCommand}"
                        Padding="8,4"/>
                    <Button Content="Экспорт в Excel..."
                        Command="{Binding ExportToExcelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Padding="8,4" Margin="8,0,0,0"/>
                    </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox IsChecked="{Binding IgnoreErrors}" Content="Игнорировать ошибки"/>
                    <Button Content="Сохранить" 
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource AcceptButtonStyle}"
                        Command="{Binding SaveCommand}"/>

                    <Button Content="Отмена" 
                        Command="{Binding CancelCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                        Style="{StaticResource CancelButtonStyle}"
                        />
                </StackPanel>
                </Grid>
            </Border>

        </Grid>
        <Border Background="#80000000"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="20"/>
                <TextBlock Text="{Binding LoadingStatus}"
                           Foreground="White"
                           FontSize="16"
                           Margin="0,10,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>



