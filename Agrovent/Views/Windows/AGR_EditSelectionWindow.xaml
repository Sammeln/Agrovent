<Window x:Class="Agrovent.Views.Windows.AGR_EditSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Agrovent.ViewModels.Windows"
        Title="{Binding Title}"
        Width="860" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Раскрываем все узлы по умолчанию (IsExpanded в узле) -->
        <Style TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовки колонок (ширины совпадают с шаблоном строки) -->
        <Grid Grid.Row="0" Margin="24,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="40"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Обозначение" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="Наименование" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="Версия" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="Кол." FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="Состояние" FontWeight="SemiBold"/>
        </Grid>

        <TreeView Grid.Row="1" ItemsSource="{Binding Roots}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:AGR_EditNodeVM}" ItemsSource="{Binding Children}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <!-- Сужается на отступ уровня, чтобы следующие колонки были выровнены -->
                            <ColumnDefinition Width="{Binding PartNumberWidth}"/>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CanToggle}" Value="False">
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <CheckBox Grid.Column="0" VerticalAlignment="Center"
                                  IsEnabled="{Binding CanToggle, Mode=OneTime}"
                                  IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PartNumber}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="{Binding VersionText}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="{Binding Quantity}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="{Binding StateText}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding State}" Value="EditingByOther">
                                            <Setter Property="Foreground" Value="#C0392B"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="EditingByMe">
                                            <Setter Property="Foreground" Value="#1E8449"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Папка локальной копии (только если копирование нужно) -->
        <Grid Grid.Row="2" Margin="0,10,0,0"
              Visibility="{Binding IsCopyRequired, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Локальная папка:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox Grid.Column="1" Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"/>
            <Button Grid.Column="2" Content="Обзор..." Width="90" Margin="8,0,0,0"
                    Command="{Binding BrowseTargetFolderCommand}"/>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{Binding ConfirmText}" MinWidth="110" Margin="0,0,8,0" Padding="8,2"
                    Command="{Binding ConfirmEditSelectionCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="Отмена" Width="110" IsCancel="True"
                    Command="{Binding CancelEditSelectionCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
